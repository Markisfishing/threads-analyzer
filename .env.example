# ============================================================
# Threads Analyzer 環境變數範本
# 複製為 .env（Worker）與 .env.local（Next.js）後填入實際值。
# ============================================================

# ---------- Web（Next.js / Vercel）----------
# Supabase 專案網址與 anon key（可公開，受 RLS 保護）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 觸發 GitHub Actions Worker（僅伺服器端使用；fine-grained token，只給此 repo 的 Actions 寫入權限）
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=owner/threads-analyzer
GITHUB_WORKFLOW_FILE=worker.yml

# ---------- Worker（GitHub Actions Secrets / 本機 .env）----------
SUPABASE_URL=https://your-project.supabase.co
# service_role key 可繞過 RLS，只能放在 Worker，絕不可放前端
SUPABASE_SERVICE_ROLE_KEY=
# Groq LLM 策略建議；留空則使用規則模板
GROQ_API_KEY=
GROQ_MODEL=
LLM_TIMEOUT_SEC=20
# Threads 登入狀態，選填；可填檔案路徑（本機，如 spike/storage_state.json）、JSON 或 base64（GitHub Secrets）。留空則只用未登入模式
THREADS_STORAGE_STATE=
# 爬取設定
SCRAPE_MAX_POSTS=30
SCRAPE_DELAY_MS_MIN=1500
SCRAPE_DELAY_MS_MAX=3000
SCRAPE_TIMEOUT_SEC=600
SCRAPE_MAX_RETRIES=3
# 本機輪詢模式間隔（秒）
WORKER_POLL_INTERVAL_SEC=5
HEADLESS=true
